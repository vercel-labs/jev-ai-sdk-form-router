# Required locally unless you use Vercel OIDC
AI_GATEWAY_API_KEY=

# Optional. Use a verified Resend sender address (e.g., no-reply@yourdomain.com) to send emails from your own domain.
RESEND_API_KEY=
RESEND_FROM=

# Configure receiving inboxes in lib/recipients.ts.
# Every destination for a form needs a valid inbox to enable its delivery checkbox.
